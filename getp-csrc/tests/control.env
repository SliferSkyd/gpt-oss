# Tham số runtime cho bench_moe
RUN_OPTS="--iters 30 --warmup 5"

# Thông số make
MAKE_JOBS=8
# MAKE_ARGS có thể truyền biến cho Makefile/hipcc (ví dụ chọn kiến trúc AMD GPU)
# MI250/MI250X  -> gfx90a
# MI300X/A     -> gfx942 / gfx941 / gfx940 (tùy model/driver)
# MI100        -> gfx908
# MAKE_ARGS="AMD_ARCH=gfx90a"

# Nếu binary không nằm ở $PROJ_DIR/bench_moe, chỉ rõ:
# BIN="$HOME/your_project/build/bench_moe"

# Điều khiển vòng lặp
UPDATED=0
FORCE_REBUILD=0   # ép rebuild giống UPDATED
FORCE_RUN=0

# (tuỳ chọn) tinh chỉnh vòng lặp
# POLL_SEC=5
# IDLE_TIMEOUT_MIN=120
