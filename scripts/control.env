# BẮT BUỘC: Thư mục làm việc và chuỗi lệnh cần chạy (compile + run)
# Ví dụ AMD: make clean && make bench_moe && ./bench_moe --iters 50 --warmup 5
WORK_DIR="/nfs/gpu_trainee/getp02/gpt-oss"
RUN_CMD='./run /gpu_trainee/final-project/modelbin/gpt-oss-20b.bin -m getp -i data/input.txt -o data/output.txt > output.txt'

# BẬT khi muốn chạy: đặt 1 (script sẽ tự reset về 0 sau khi chạy xong)
UPDATED=1

# (Tuỳ chọn) Chạy ngay khi job khởi động (mặc định 0)
# RUN_ON_START=1

# (Tuỳ chọn) Thêm biến môi trường trước khi chạy
# ENV_EXPORT='export OMP_NUM_THREADS=8; export AMD_ARCH=gfx90a'

# (Tuỳ chọn) Dùng srun hay chạy trực tiếp (mặc định 1)
# WRAP_WITH_SRUN=1
# SRUN_ARGS="-n 1"

# (Tuỳ chọn) Thời gian idle tự thoát, phút (0=tắt)
# IDLE_TIMEOUT_MIN=0

# (Tuỳ chọn) Thư mục log cho mỗi lần chạy
# RUN_LOG_DIR="$HOME/runlogs"

# (Tuỳ chọn) Kỳ polling nếu không có inotifywait
# POLL_SEC=5
