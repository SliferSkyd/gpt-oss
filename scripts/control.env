# BẮT BUỘC: Thư mục làm việc và chuỗi lệnh compile + run
WORK_DIR="$HOME/tmp1/gpt-oss"
RUN_CMD='./run /gpu_trainee/final-project/modelbin/gpt-oss-20b.bin -m getp -i data/input.txt -o data/output.txt > output.txt'

# BẬT khi muốn chạy (script sẽ tự reset về 0 sau khi chạy xong, dù thành công hay lỗi)
UPDATED=1

# (Tuỳ chọn) Chạy ngay khi job vừa start
# RUN_ON_START=1

# (Tuỳ chọn) Export env trước khi chạy (ví dụ cho ROCm/AMD)
# ENV_EXPORT='export AMD_ARCH=gfx90a; export OMP_NUM_THREADS=8'

# (Tuỳ chọn) Dùng srun hay không
# WRAP_WITH_SRUN=1
# SRUN_ARGS="-n 1 --cpus-per-task=8"

# (Tuỳ chọn) Idle auto-exit (phút). 0 = tắt
# IDLE_TIMEOUT_MIN=0

# (Tuỳ chọn) Vị trí log và kỳ polling
# RUN_LOG_DIR="$HOME/runlogs"
# POLL_SEC=5
