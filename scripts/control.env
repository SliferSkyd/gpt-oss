
# === BẮT BUỘC ===
# Thư mục làm việc & chuỗi lệnh compile + run
WORK_DIR="/nfs/gpu_trainee/getp03/tmp1/gpt-oss/"
RUN_CMD='./run /gpu_trainee/final-project/modelbin/gpt-oss-20b.bin -m getp -i data/input.txt -o data/output1.txt > output.txt'

# === CỜ HÀNH ĐỘNG (script sẽ tự reset về 0 sau khi xử lý) ===
START=0
STOP=0        # đặt 1 để STOP (nếu đang chạy)
RESTART=0     # đặt 1 để STOP rồi START lại
UPDATED=0

# === TUỲ CHỌN HÀNH VI ===
ON_UPDATED="restart"      # "restart" (mặc định) hoặc "start"
RUN_ON_START=0            # 1 = job mới lên là chạy luôn
AUTORESTART_ON_EXIT=0     # 1 = nếu tiến trình tự thoát sẽ tự start lại

# === SRUN / LOG / ENV ===
WRAP_WITH_SRUN=1
SRUN_ARGS="-n 1 --cpus-per-task=8"
RUN_LOG_DIR="$HOME/runlogs"
# ENV_EXPORT='export AMD_ARCH=gfx90a; export OMP_NUM_THREADS=8'

# === Nhà bếp phụ ===
# POLL_SEC=3
# IDLE_TIMEOUT_MIN=0        # >0 = tự thoát khi rảnh quá X phút
